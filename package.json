{
  "name": "splittext-react",
  "version": "0.1.0",
  "description": "Split text into lines, words and characters in React. Container-aware, font-aware, SSR-safe and batched for pages with lots of text.",
  "keywords": [
    "react",
    "split-text",
    "split",
    "text",
    "lines",
    "words",
    "chars",
    "typography",
    "animation",
    "gsap",
    "typescript"
  ],
  "license": "MIT",
  "author": "Gustavo Cardoso",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gcardoso23/splittext-react.git"
  },
  "homepage": "https://github.com/gcardoso23/splittext-react#readme",
  "bugs": {
    "url": "https://github.com/gcardoso23/splittext-react/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "dev": "vite playground",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.3",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
